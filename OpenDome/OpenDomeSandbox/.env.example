# =============================================================================
# OpenDome Sandbox - host env (not a mini-app)
# Same shape as OpenDomeApp. Mini-apps only need OD_APP_TOKEN + dock host URL.
# Never commit real values.
# =============================================================================

# --- Auth: human login sessions (passkey -> role JWT) ---
# Signs/verifies user + staff session JWTs (user | admin | scanner | god).
SESSION_JWT_TOKEN=

# --- Auth: MQTT / realtime channel JWTs (wsJwt, hostJwt) ---
# Also used as HMAC key for Solana payment proofs when present.
MQTT_JWT_TOKEN=

# --- Auth: mini-app docking (enrollment + handshake JWTs) ---
# Host-only. Shared by OpenDomeApp + OpenDomeSandbox. Never ship to mini-apps/browsers.
DOCKING_JWT_TOKEN=

# --- Auth: platform service bearer (mint / scan / hotfix fulfill) ---
# Opaque machine token - not a JWT. Authorization: Bearer <value>
ADMIN_SERVICE_TOKEN=

# OpenDomeApp only (omit on Sandbox):
# CRON_SECRET=

# --- Google Cloud (Firestore users/tickets + telemetry / agent) ---
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# --- Circle (wallets / AgentKit / x402 tools) ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# --- Contract (OpenDome ERC-1155 pass on Base) ---
CONTRACT_ADDRESS=

# --- EVM merchant (mint, checkout, sponsored USDC) ---
MERCHANT_ADDRESS=
MERCHANT_PRIVATE_KEY=

# --- Solana merchant (sponsor fees / settlement) ---
MERCHANT_SOLANA_ADDRESS=
MERCHANT_SOLANA_PRIVATE_KEY=
