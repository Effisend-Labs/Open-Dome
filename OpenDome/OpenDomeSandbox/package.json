{
  "name": "opendomesandbox",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --port 8083 -c",
    "android": "expo start --android --port 8083",
    "ios": "expo start --ios --port 8083",
    "web": "set BROWSER=none&& expo start --web --port 8083 -c",
    "build": "npx expo export -p web",
    "webbuild": "npx expo export -p web",
    "webdeploy": "npx expo export -p web && eas deploy",
    "webprod": "npx expo export -p web && eas deploy --prod",
    "webserve": "npx expo export -p web && npx expo serve",
    "lint": "expo lint"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1100.0",
    "@aws-sdk/client-dynamodb": "^3.1095.0",
    "@aws-sdk/lib-dynamodb": "^3.1095.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@circle-fin/x402-batching": "^3.2.0",
    "@expo/server": "^0.7.5",
    "@expo/vector-icons": "^15.1.1",
    "@google-cloud/firestore": "^8.7.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^2.13.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/elements": "^2.9.36",
    "@react-navigation/native": "^7.3.14",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@smithy/node-http-handler": "^4.9.13",
    "@x402/core": "^2.19.0",
    "@x402/evm": "^2.19.0",
    "ethers": "^6.17.0",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "hono": "^4.12.32",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.15.2",
    "opendome": "file:../../open-dome-lib",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^1000.0.0",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.2",
    "react-native-sonner": "^0.2.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.11.3",
    "uuid": "^11.0.0",
    "viem": "^2.55.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^10.8.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "expo-modules-core": {
      "react-native-worklets": "$react-native-worklets"
    },
    "react": "$react",
    "react-dom": "$react-dom",
    "react-native-worklets": "$react-native-worklets",
    "react-native": "$react-native",
    "typescript": "$typescript",
    "eslint": "$eslint",
    "uuid": "^11.0.0"
  },
  "private": true
}
