{
  "installCommand": "npm install --legacy-peer-deps && cd ../../open-dome-lib && npm install --legacy-peer-deps",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist/client",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ./ ../../open-dome-lib 2>/dev/null || exit 1",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
