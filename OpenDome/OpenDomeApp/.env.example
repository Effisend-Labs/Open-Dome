# =============================================================================
# OpenDomeApp - production host env
# Share DOCKING_JWT_TOKEN with OpenDomeSandbox. Never commit real values.
# Mini-apps only need OD_APP_TOKEN (host URL auto-resolves).
# =============================================================================

# --- Auth: human login sessions (passkey -> role JWT) ---
SESSION_JWT_TOKEN=

# --- Auth / HMAC: Solana payment proofs (and legacy MQTT JWT signing when re-enabled) ---
# Also used as HMAC key for Solana payment proofs when present.
MQTT_JWT_TOKEN=

# --- Auth: mini-app docking (enrollment + handshake JWTs) ---
# Host-only. Shared by OpenDomeApp + OpenDomeSandbox.
DOCKING_JWT_TOKEN=

# --- Auth: platform service bearer (mint / scan / hotfix fulfill) ---
ADMIN_SERVICE_TOKEN=

# --- Auth: Vercel Cron (App only) ---
CRON_SECRET=

# --- Google Cloud (Firestore users/tickets + telemetry / agent) ---
# Optional: `dev` uses Dev-prefixed collections; production is inferred on Vercel.
FIRESTORE_ENV=
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# --- Circle (wallets / AgentKit / x402 tools) ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# --- Contract (OpenDome ERC-1155 pass on Base) ---
CONTRACT_ADDRESS=

# --- EVM merchant (mint, checkout, sponsored USDC) ---
MERCHANT_ADDRESS=
MERCHANT_PRIVATE_KEY=

# --- Reserved administrator identity (provision this user out-of-band) ---
ADMIN_USERNAME=

# --- Solana merchant (sponsor fees / settlement) ---
MERCHANT_SOLANA_ADDRESS=
MERCHANT_SOLANA_PRIVATE_KEY=
