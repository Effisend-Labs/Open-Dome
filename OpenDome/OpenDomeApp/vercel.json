{
  "installCommand": "cd ../../open-dome-lib && npm install --legacy-peer-deps && npm run build && cd ../OpenDome/OpenDomeApp && npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/OpenDome/OpenDomeApp :/open-dome-lib 2>/dev/null || exit 1",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/server/**,node_modules/opendome/dist/**,node_modules/{@google-cloud/firestore,@grpc,@circle-fin,google-gax,google-auth-library,protobufjs,google-logging-utils}/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
