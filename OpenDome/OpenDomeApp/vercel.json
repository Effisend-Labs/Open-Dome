{
  "installCommand": "npm install --legacy-peer-deps && cd ../../open-dome-lib && npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/OpenDome/OpenDomeApp :/open-dome-lib 2>/dev/null || exit 1",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/server/**,node_modules/@google-cloud/**,node_modules/@circle-fin/**,node_modules/@simplewebauthn/**,node_modules/@google/genai/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
