{
  "name": "opendomeapp",
  "version": "1.0.0",
  "author": "altaga",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8082 -c",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "web": "set BROWSER=none&& expo start --web --port 8082 -c",
    "build": "npx expo export -p web",
    "webprod": "expo export -p web && eas deploy --prod"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1054.0",
    "@aws-sdk/client-dynamodb": "^3.1048.0",
    "@aws-sdk/lib-dynamodb": "^3.1048.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@expo-google-fonts/exo-2": "0.4.2",
    "@expo/server": "^0.7.5",
    "@expo/vector-icons": "15.1.1",
    "@google-cloud/firestore": "^8.7.0",
    "@google/genai": "^2.15.0",
    "@react-native-async-storage/async-storage": "3.0.2",
    "@react-navigation/bottom-tabs": "7.15.13",
    "@react-navigation/elements": "2.9.17",
    "@react-navigation/native": "7.2.4",
    "@simplewebauthn/browser": "^13.0.0",
    "@smithy/node-http-handler": "^4.7.4",
    "buffer": "6.0.3",
    "expo": "55.0.23",
    "expo-constants": "56.0.6",
    "expo-font": "56.0.3",
    "expo-haptics": "56.0.3",
    "expo-image": "56.0.4",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "56.0.4",
    "expo-location": "~55.1.10",
    "expo-router": "56.1.1",
    "expo-secure-store": "56.0.3",
    "expo-splash-screen": "56.0.4",
    "expo-status-bar": "56.0.4",
    "expo-symbols": "56.0.5",
    "expo-system-ui": "56.0.4",
    "expo-web-browser": "56.0.4",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.15.1",
    "ol": "^10.9.0",
    "opendome": "file:../../open-dome-lib",
    "react": "19.0.6",
    "react-dom": "19.0.6",
    "react-native": "0.85.3",
    "react-native-draggable-grid": "^2.2.2",
    "react-native-draglist": "^3.10.0",
    "react-native-gesture-handler": "2.31.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.24.0",
    "react-native-sonner": "0.2.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "eslint": "10.3.0",
    "eslint-config-expo": "56.0.2",
    "typescript": "6.0.3"
  },
  "private": true,
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "react-native-worklets": "$react-native-worklets",
    "typescript": "$typescript",
    "eslint": "$eslint",
    "uuid": "^11.0.0"
  }
