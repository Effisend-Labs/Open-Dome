{
  "installCommand": "npm install --legacy-peer-deps && cd ../../../open-dome-lib && npm install --legacy-peer-deps",
  "buildCommand": "npm run build --prefix ../../../open-dome-lib && npm run build",
  "outputDirectory": "dist/client",
  "ignoreCommand": "node ../../../scripts/vercel-ignore.cjs . ../../../open-dome-lib",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/server/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
