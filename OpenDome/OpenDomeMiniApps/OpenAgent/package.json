{
  "name": "openagent",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --port 8086 -c",
    "android": "expo start --android --port 8086",
    "ios": "expo start --ios --port 8086",
    "web": "set BROWSER=none&& expo start --web --port 8086 -c",
    "build": "npx expo export -p web"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.8",
    "@expo/server": "^0.7.5",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.9",
    "expo-constants": "57.0.8",
    "expo-linking": "57.0.4",
    "expo-router": "57.0.9",
    "expo-status-bar": "57.0.1",
    "opendome": "file:../../../open-dome-lib",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "uuid": "^11.0.0"
  }
}
