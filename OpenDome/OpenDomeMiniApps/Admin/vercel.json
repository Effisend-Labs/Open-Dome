{
  "installCommand": "npm install --legacy-peer-deps && cd ../../../open-dome-lib && npm install --legacy-peer-deps",
  "buildCommand": "npm run build --prefix ../../../open-dome-lib && npm run build",
  "outputDirectory": "dist/client",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/OpenDome/OpenDomeMiniApps/Admin :/open-dome-lib 2>/dev/null || exit 1",
  "functions": {
    "api/index.js": {
      "includeFiles": "{dist/server/**,node_modules/ethers/**,node_modules/@noble/**,node_modules/@adraffy/**,node_modules/aes-js/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
