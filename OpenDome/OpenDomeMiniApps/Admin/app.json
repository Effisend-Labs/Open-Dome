{
  "expo": {
    "name": "Admin",
    "slug": "opendome-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "opendomeadmin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "output": "server",
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "altaga",
    "server": {
      "nodeModules": ["@google-cloud/firestore", "ethers"]
    }
  }
}
