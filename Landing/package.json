{
  "name": "opendomelanding",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "57.0.7",
    "@expo/vector-icons": "15.1.1",
    "@react-navigation/native": "^7.3.13",
    "expo": "57.0.9",
    "expo-constants": "57.0.8",
    "expo-device": "57.0.1",
    "expo-font": "57.0.1",
    "expo-glass-effect": "57.0.1",
    "expo-image": "57.0.1",
    "expo-linking": "57.0.4",
    "expo-router": "57.0.9",
    "expo-splash-screen": "57.0.5",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.1",
    "expo-system-ui": "57.0.2",
    "expo-web-browser": "57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8081",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "web": "set BROWSER=none&& expo start --web --port 8081",
    "build": "npx expo export -p web",
    "webbuild": "npx expo export -p web",
    "webdeploy": "npx expo export -p web && eas deploy",
    "webserve": "npx expo export -p web && npx expo serve",
    "lint": "expo lint"
  },
  "overrides": {
    "uuid": "^11.0.0",
    "expo-modules-core": {
      "react-native-worklets": "$react-native-worklets"
    },
    "react": "$react",
    "react-dom": "$react-dom",
    "react-native-worklets": "$react-native-worklets",
    "typescript": "$typescript",
    "eslint": "$eslint"
  },
  "private": true
}
